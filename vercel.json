{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/(?:__canasta|api/canasta)/(.*)", "dest": "/api/canasta?canasta_path=$1" },
    {
      "src": "/(?:__run21|api/run21)/(.*)",
      "dest": "/api/run21?run21_path=$1"
    },
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "status": 404 },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "ignoreCommand": "node scripts/deployment/ignore-build.mjs",
  "buildCommand": "npm run build",
  "functions": {
    "api/delayed-run21.ts": {
      "regions": ["cle1"]
    },
    "api/web-push.ts": {
      "maxDuration": 60
    },
    "api/run21.ts": {
      "maxDuration": 300
    }
  }
}
